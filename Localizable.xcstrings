{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ""
          }
        }
      }
    },
    "[*] This application is open source at the following link: https://github.com/SteveLeungYL/WaterTracker. If you find it useful, please consider giving it a star! ❤️" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[*] 这个软件在GitHub开源，网址是：https://github.com/SteveLeungYL/WaterTracker。如果你喜欢这个软件，请考虑在GitHub给我个Star! ❤️"
          }
        }
      }
    },
    "[1]" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[1]"
          }
        }
      }
    },
    "[1] Cleveland Clinic. (2024, October 3). How much water you should drink every day. https://health.clevelandclinic.org/how-much-water-do-you-need-daily" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[1] 人体一天正常喝多少水. 百度一下. https://m.baidu.com/bh/m/detail/ar_14262496206050086254 "
          }
        }
      }
    },
    "[2] Non-water drinks are saved to Apple Health as their effective hydration volume (volume × hydration factor, capped at the poured volume). Factors follow the Beverage Hydration Index (Maughan et al., 2016, Am J Clin Nutr)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[2] 非水饮品按其有效补水量（容量×水合系数，上限为实际饮用量）保存到 Apple Health。系数遵循饮料水合指数（Maughan 等，2016，Am J Clin Nutr）。"
          }
        }
      }
    },
    "%@ + " : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ + "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@+"
          }
        }
      }
    },
    "%@ counts as %@ of its volume toward your daily goal, based on how well it hydrates (Maughan et al. 2016)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ counts as %2$@ of its volume toward your daily goal, based on how well it hydrates (Maughan et al. 2016)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@按其容量的%2$@计入每日目标，基于其补水效果（Maughan 等，2016）。"
          }
        }
      }
    },
